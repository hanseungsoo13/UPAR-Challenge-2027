{
  "experiment": "AttrQuery-PatchFiLM-JointFromCLIP",
  "model_name": "ViT-B-32-quickgelu",
  "pretrained_tag": "openai",
  "data_root": "data",
  "output_dir": "outputs/AttrQuery-PatchFiLM-JointFromCLIP",
  "device": "auto",
  "epochs": 100,
  "batch_size": 128,
  "eval_batch_size": 128,
  "num_workers": 4,
  "image_size": 224,
  "rotation": 10.0,
  "augmentation": "resize_pad_crop",
  "learning_rate": 1e-5,
  "head_learning_rate": 1e-4,
  "weight_decay": 0.01,
  "warmup_epochs": 5,
  "min_learning_rate": 1e-7,
  "grad_clip": 1.0,
  "focal_alpha": 1.0,
  "focal_gamma": 2.0,
  "category_temperature": 0.01,
  "local_loss_weight": 0.5,
  "local_loss_warmup_epochs": 0,
  "num_heads": 8,
  "dropout": 0.1,
  "use_ffn": true,
  "freeze_text_encoder": false,
  "freeze_logit_scale": false,
  "text_sampling": "single",
  "contrastive_target": "multi_positive",
  "multi_label": false,
  "category_ce": false,
  "global_objective": "paper_fce",
  "validation_protocol": "native52_category_nll",
  "selection_alpha": 0.5,
  "selection_metric": "mADM",
  "seed": 42,
  "deterministic": false,
  "amp": true,
  "minimum_training_epochs": 50,
  "early_stopping_patience": 20,
  "gradient_diagnostics_interval": 100,
  "progress_every": 0,
  "max_train_samples": null,
  "max_val_samples": null,
  "bottleneck_ratio": 4,
  "patchfilm_delta": 0.1,
  "patchfilm_category_chunk_size": 4
}
